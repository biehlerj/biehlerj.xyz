---
import Layout from "@layouts/Layout.astro";
import pfp from "@assets/pfp.webp";
import SocialIcons from "@components/SocialIcons.astro";
import "@styles/global.css";
import { getCollection, render } from "astro:content";
import MultiDate from "@components/MultiDate.astro";
import MonthYearDate from "@components/MonthYearDate.astro";

const allExperience = await getCollection("experience");
allExperience.sort(
  (a, b) => b.data.beginDate.getTime() - a.data.beginDate.getTime(),
);

const allProjects = await getCollection("projects");
allProjects.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allEducation = await getCollection("education");
allEducation.sort(
  (a, b) => b.data.beginDate.getTime() - a.data.beginDate.getTime(),
);
---

<Layout title="Jacob Biehler">
  <main class="main space-y-12 pb-16">
    <section class="flex flex-col items-center text-center mb-12 mt-8">
      <img
        src={pfp.src}
        alt="Jacob Biehler"
        class="w-32 h-32 rounded-full border-4 border-[var(--accent-color)] shadow-lg mb-4 object-cover"
      />
      <h1 class="text-4xl font-extrabold m-0 text-[var(--text-color)]">
        Jacob Biehler
      </h1>
      <p class="text-xl italic text-[var(--subtext-color)] mt-2">
        Software Engineer and FOSS Enthusiast
      </p>
      <div class="mt-4 flex justify-center">
        <SocialIcons />
      </div>
    </section>

    <div
      class="flex gap-4 justify-center mb-8 border-b border-gray-600 pb-8 flex-wrap"
    >
      <a
        href="#experience"
        class="px-4 py-2 bg-[var(--home-link-color)] rounded shadow hover:bg-[var(--accent-color)] hover:text-white dark:hover:text-gray-900 no-underline text-[var(--text-color)] font-medium transition-colors"
        >Experience</a
      >
      <a
        href="#projects"
        class="px-4 py-2 bg-[var(--home-link-color)] rounded shadow hover:bg-[var(--accent-color)] hover:text-white dark:hover:text-gray-900 no-underline text-[var(--text-color)] font-medium transition-colors"
        >Projects</a
      >
      <a
        href="#education"
        class="px-4 py-2 bg-[var(--home-link-color)] rounded shadow hover:bg-[var(--accent-color)] hover:text-white dark:hover:text-gray-900 no-underline text-[var(--text-color)] font-medium transition-colors"
        >Education</a
      >
    </div>

    <!-- Experience Section -->
    <section
      id="experience"
      class="prose dark:prose-invert max-w-none text-left"
    >
      <h2 class="text-3xl font-bold mb-6 border-b border-gray-600 pb-2">
        Experience
      </h2>
      <div class="space-y-8">
        {
          allExperience.map(async (experience) => {
            const { Content } = await render(experience);
            return (
              <div
                class="experience-entry border-b border-gray-700/50 pb-8 last:border-0 last:pb-0"
                id={experience.id}
              >
                <div class="flex justify-between items-baseline mb-2 flex-wrap">
                  <h3 class="text-xl font-bold m-0">
                    <a
                      href={`#${experience.id}`}
                      class="no-underline text-[var(--text-color)] hover:text-[var(--accent-color)]"
                    >
                      {experience.data.title}
                    </a>
                  </h3>
                  <div class="text-sm italic text-[var(--subtext-color)]">
                    <MultiDate
                      firstDate={experience.data.beginDate}
                      secondDate={experience.data.endDate}
                    />
                  </div>
                </div>

                <div class="mt-4">
                  {experience.data.highlights ? (
                    <ul class="list-disc pl-5 mt-2">
                      {experience.data.highlights.map((highlight: string) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  ) : (
                    <Content />
                  )}
                </div>

                <div class="mt-4">
                  <a
                    href={`/experience/${experience.id}`}
                    class="text-sm underline text-[var(--accent-color)] opacity-90 hover:opacity-100 font-medium"
                  >
                    Read full details &rarr;
                  </a>
                </div>

                {experience.data.skills &&
                  experience.data.skills.length > 0 && (
                    <div class="mt-3 text-sm text-[var(--subtext-color)]">
                      <strong class="text-[var(--text-color)]">
                        Skills:
                      </strong>{" "}
                      {experience.data.skills.join(", ")}
                    </div>
                  )}
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Projects Section -->
    <section
      id="projects"
      class="prose dark:prose-invert max-w-none text-left pt-8"
    >
      <h2 class="text-3xl font-bold mb-6 border-b border-gray-600 pb-2">
        Projects
      </h2>
      <div class="space-y-8">
        {
          allProjects.map(async (project) => {
            const { Content } = await render(project);
            return (
              <div
                class="project-entry border-b border-gray-700/50 pb-8 last:border-0 last:pb-0"
                id={project.id}
              >
                <div class="flex justify-between items-baseline mb-2 flex-wrap">
                  <h3 class="text-xl font-bold m-0">
                    <a
                      href={`#${project.id}`}
                      class="no-underline text-[var(--text-color)] hover:text-[var(--accent-color)]"
                    >
                      {project.data.title}
                    </a>
                  </h3>
                  <div class="text-sm italic text-[var(--subtext-color)]">
                    <MonthYearDate date={project.data.date} />
                  </div>
                </div>

                <div class="mt-4">
                  {project.data.highlights ? (
                    <ul class="list-disc pl-5 mt-2">
                      {project.data.highlights.map((highlight: string) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  ) : (
                    <Content />
                  )}
                </div>

                <div class="mt-4">
                  <a
                    href={`/projects/${project.id}`}
                    class="text-sm underline text-[var(--accent-color)] opacity-90 hover:opacity-100 font-medium"
                  >
                    Read full details &rarr;
                  </a>
                </div>

                {project.data.skills && project.data.skills.length > 0 && (
                  <div class="mt-3 text-sm text-[var(--subtext-color)]">
                    <strong class="text-[var(--text-color)]">
                      Skills:
                    </strong>{" "}
                    {project.data.skills.join(", ")}
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </section>

    <!-- Education Section -->
    <section
      id="education"
      class="prose dark:prose-invert max-w-none text-left pt-8"
    >
      <h2 class="text-3xl font-bold mb-6 border-b border-gray-600 pb-2">
        Education
      </h2>
      <div class="space-y-8">
        {
          allEducation.map(async (edu) => {
            const { Content } = await render(edu);
            return (
              <div
                class="education-entry border-b border-gray-700/50 pb-8 last:border-0 last:pb-0"
                id={edu.id}
              >
                <div class="flex justify-between items-baseline mb-2 flex-wrap">
                  <h3 class="text-xl font-bold m-0">
                    <a
                      href={`#${edu.id}`}
                      class="no-underline text-[var(--text-color)] hover:text-[var(--accent-color)]"
                    >
                      {edu.data.title}
                    </a>
                  </h3>
                  <div class="text-sm italic text-[var(--subtext-color)]">
                    <MultiDate
                      firstDate={edu.data.beginDate}
                      secondDate={edu.data.endDate}
                    />
                  </div>
                </div>
                <div class="font-medium mt-1 text-[var(--text-color)]">
                  {edu.data.degree} — {edu.data.location}
                </div>

                <div class="mt-4">
                  {edu.data.highlights ? (
                    <ul class="list-disc pl-5 mt-2">
                      {edu.data.highlights.map((highlight: string) => (
                        <li>{highlight}</li>
                      ))}
                    </ul>
                  ) : (
                    <Content />
                  )}
                </div>

                <div class="mt-4">
                  <a
                    href={`/education/${edu.id}`}
                    class="text-sm underline text-[var(--accent-color)] opacity-90 hover:opacity-100 font-medium"
                  >
                    Read full details &rarr;
                  </a>
                </div>

                {edu.data.skills && edu.data.skills.length > 0 && (
                  <div class="mt-3 text-sm text-[var(--subtext-color)]">
                    <strong class="text-[var(--text-color)]">
                      Skills:
                    </strong>{" "}
                    {edu.data.skills.join(", ")}
                  </div>
                )}
              </div>
            );
          })
        }
      </div>
    </section>
  </main>
</Layout>
